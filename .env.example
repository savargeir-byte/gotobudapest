# Copy to .env.local for local work. .env.local is git-ignored; never commit secrets.
# In Vercel, set these under Project -> Settings -> Environment Variables and use
# separate values for Production and Preview where it makes sense.

# --- Public (safe in the browser: they appear in every public CDN URL) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=ut6qxuke
NEXT_PUBLIC_SANITY_DATASET=production

# Confirmed production origin (https, no path). While unset the site is served
# noindex and robots.txt disallows crawling.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Used ONLY by scripts/sanity-seed.ts on the build machine to create the initial
# content (createIfNotExists). Give it the narrowest role that can create
# documents and upload images, and rotate it if it is ever exposed.
# SANITY_API_TOKEN=

# Signs/validates the Sanity webhook that revalidates cached content. Use a long
# random value (for example: openssl rand -base64 32) and put the same value in
# the webhook configuration at sanity.io/manage.
# SANITY_REVALIDATE_SECRET=

# Seeding during builds is OFF by default. Set to 1 only for a build you intend to seed
# (needs SANITY_API_TOKEN with write access). Prefer the manual "Seed Sanity" workflow.
# SANITY_SEED_ON_BUILD=1

# After the migration is verified, fail builds that would silently use local content.
# REQUIRE_SANITY_CONTENT=1
